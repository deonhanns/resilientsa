# ResilientSA — Environment Variables
# Copy this to .env.local and fill in values

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/resilientsa?sslmode=require

# pgcrypto symmetric encryption key — minimum 32 characters, generated once, never rotated
ENCRYPTION_KEY=minimum-32-character-random-key-here

# Africa's Talking (SMS + WhatsApp — ORDER 004)
AT_API_KEY=your-africas-talking-api-key
AT_USERNAME=your-africas-talking-username
AT_SENDER_ID=ResilientSA

# Vercel
VERCEL_URL=
