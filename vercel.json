{
  "framework": "vite",
  "buildCommand": "cd resilientsa-app && npm install && npm run build",
  "outputDirectory": "resilientsa-app/dist",
  "installCommand": "cd resilientsa-app && npm install",
  "functions": {
    "resilientsa-app/api/**/*.ts": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
