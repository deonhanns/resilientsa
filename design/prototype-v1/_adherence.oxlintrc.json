{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/foundation/**",
              "components/navigation/**",
              "components/pillars/**",
              "ui_kits/resilientsa-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Ubuntu|Inter))/i]",
        "message": "Font not provided by the design system. Available: Ubuntu, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|trailing|key|ref|className|style|children)$/]",
        "message": "<AppBar> doesn't accept that prop. Declared props: title, onBack, trailing."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|showIcon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon, showIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:offer|need|success|pending|info|neutral)$/]",
        "message": "<Badge> tone must be one of 'offer' | 'need' | 'success' | 'pending' | 'info' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: key, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|fullWidth|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|urgent)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'urgent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|padding|interactive|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: as, padding, interactive."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, body, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|label|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|hint|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, icon, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|pillar|kind|member|place|steward|actionLabel|onAction|onMatch|key|ref|className|style|children)$/]",
        "message": "<ListingCard> doesn't accept that prop. Declared props: title, pillar, kind, member, place, steward, actionLabel, onAction, onMatch."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListingCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:offer|need)$/]",
        "message": "<ListingCard> kind must be one of 'offer' | 'need'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MemberRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|place|status|connections|onReach|key|ref|className|style|children)$/]",
        "message": "<MemberRow> doesn't accept that prop. Declared props: name, place, status, connections, onReach."
      },
      {
        "selector": "JSXOpeningElement[name.name='MemberRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:active|quiet|isolate)$/]",
        "message": "<MemberRow> status must be one of 'active' | 'quiet' | 'isolate'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NeedsRadar'] > JSXAttribute > JSXIdentifier[name!=/^(?:needs|size|onPillar|key|ref|className|style|children)$/]",
        "message": "<NeedsRadar> doesn't accept that prop. Declared props: needs, size, onPillar."
      },
      {
        "selector": "JSXOpeningElement[name.name='NetworkSummary'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|trend|stat|key|ref|className|style|children)$/]",
        "message": "<NetworkSummary> doesn't accept that prop. Declared props: message, trend, stat."
      },
      {
        "selector": "JSXOpeningElement[name.name='NetworkSummary'] > JSXAttribute[name.name='trend'] > Literal[value!=/^(?:growing|steady|thinning)$/]",
        "message": "<NetworkSummary> trend must be one of 'growing' | 'steady' | 'thinning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:pillar|selected|key|ref|className|style|children)$/]",
        "message": "<PillarButton> doesn't accept that prop. Declared props: pillar, selected."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:pillar|variant|showLabel|size|key|ref|className|style|children)$/]",
        "message": "<PillarTag> doesn't accept that prop. Declared props: pillar, variant, showLabel, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarTag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|soft|glyph)$/]",
        "message": "<PillarTag> variant must be one of 'solid' | 'soft' | 'glyph'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarTag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<PillarTag> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgrammeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|pillar|summary|communitiesCount|provider|requestLabel|onRequest|key|ref|className|style|children)$/]",
        "message": "<ProgrammeCard> doesn't accept that prop. Declared props: title, pillar, summary, communitiesCount, provider, requestLabel, onRequest."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|activeColor|key|ref|className|style|children)$/]",
        "message": "<SegmentOption> doesn't accept that prop. Declared props: value, label, icon, activeColor."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
